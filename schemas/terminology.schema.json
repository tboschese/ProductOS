{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-os.dev/schemas/terminology.schema.json",
  "title": "ProductOS terminology entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "concept_id", "canonical_name", "localized", "status", "review"],
  "properties": {
    "id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
    "schema_version": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/schemaVersion"},
    "concept_id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
    "canonical_name": {"type": "string", "minLength": 1},
    "localized": {
      "type": "object",
      "minProperties": 1,
      "required": ["en"],
      "propertyNames": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/locale"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["preferred", "aliases"],
        "properties": {
          "preferred": {"type": "string", "minLength": 1},
          "aliases": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
          "notes": {"type": "string"}
        }
      }
    },
    "status": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/status"},
    "review": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/review"}
  }
}
