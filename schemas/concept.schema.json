{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-os.dev/schemas/concept.schema.json",
  "title": "ProductOS concept",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "schema_version", "canonical_name", "definition", "primary_domain",
    "facets", "aliases", "claim_ids", "status", "review"
  ],
  "properties": {
    "id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
    "schema_version": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/schemaVersion"},
    "canonical_name": {"type": "string", "minLength": 1},
    "definition": {"type": "string", "minLength": 1},
    "primary_domain": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
    "facets": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/facets"},
    "aliases": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
    "claim_ids": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/idList"},
    "status": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/status"},
    "review": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/review"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]},
      "then": {"properties": {"claim_ids": {"minItems": 1}}}
    }
  ]
}
