{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-os.dev/schemas/calibration-control-judging.schema.json",
  "title": "ProductOS automated judging of labeled negative controls",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "review_packet_sha256", "judge", "judge_cli_version",
    "run_cli_version", "judged_at", "controls", "interpretation"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "run_id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
    "review_packet_sha256": {"$ref": "https://product-os.dev/schemas/calibration-packet.schema.json#/$defs/sha256"},
    "judge": {"$ref": "https://product-os.dev/schemas/eval-run.schema.json#/$defs/judge"},
    "judge_cli_version": {"type": "string", "minLength": 1},
    "run_cli_version": {"type": "string", "minLength": 1},
    "judged_at": {"type": "string", "format": "date-time"},
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id", "case_id", "control_sha256", "detected_all", "missed",
          "hard_failures_observed", "forbidden_behaviors_observed", "dimension_scores"
        ],
        "properties": {
          "control_id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
          "case_id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
          "control_sha256": {"$ref": "https://product-os.dev/schemas/calibration-packet.schema.json#/$defs/sha256"},
          "detected_all": {"type": "boolean"},
          "missed": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "hard_failures_observed": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "forbidden_behaviors_observed": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "dimension_scores": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/rubricDimension"},
            "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 4}
          }
        }
      }
    },
    "interpretation": {"type": "string", "minLength": 1}
  }
}
