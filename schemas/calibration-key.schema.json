{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-os.dev/schemas/calibration-key.schema.json",
  "title": "ProductOS judge-calibration coordinator key",
  "description": "Maps blind packet items to their provenance. Keep away from reviewers until scoring is complete.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "packet_sha256", "run_id", "run_sha256", "review_packet_sha256",
    "seed", "items"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "packet_sha256": {"$ref": "https://product-os.dev/schemas/calibration-packet.schema.json#/$defs/sha256"},
    "run_id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
    "run_sha256": {"$ref": "https://product-os.dev/schemas/calibration-packet.schema.json#/$defs/sha256"},
    "review_packet_sha256": {"$ref": "https://product-os.dev/schemas/calibration-packet.schema.json#/$defs/sha256"},
    "seed": {"type": "integer"},
    "items": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "https://product-os.dev/schemas/calibration-packet.schema.json#/$defs/itemId"},
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "case_id", "repetition"],
            "properties": {
              "kind": {"const": "run"},
              "case_id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
              "repetition": {"type": "integer", "minimum": 1}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "case_id", "control_id", "control_sha256"],
            "properties": {
              "kind": {"const": "control"},
              "case_id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
              "control_id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
              "control_sha256": {"$ref": "https://product-os.dev/schemas/calibration-packet.schema.json#/$defs/sha256"}
            }
          }
        ]
      }
    }
  }
}
