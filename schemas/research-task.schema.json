{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-os.dev/schemas/research-task.schema.json",
  "title": "ProductOS research task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "schema_version", "title", "primary_domain", "research_question", "why_it_matters",
    "scope", "out_of_scope", "subtopics", "primary_source_plan", "secondary_source_plan",
    "questions", "expected_outputs", "conflicting_views_to_investigate", "acceptance_criteria",
    "review_status", "review"
  ],
  "properties": {
    "id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
    "schema_version": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/schemaVersion"},
    "title": {"type": "string", "minLength": 1},
    "primary_domain": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
    "research_question": {"type": "string", "minLength": 1},
    "why_it_matters": {"type": "string", "minLength": 1},
    "scope": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
    "out_of_scope": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
    "subtopics": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
    "primary_source_plan": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
    "secondary_source_plan": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
    "questions": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
    "expected_outputs": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
    "conflicting_views_to_investigate": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
    "acceptance_criteria": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
    "review_status": {"type": "string", "enum": ["draft", "in_review", "approved", "rejected"]},
    "review": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/review"}
  }
}
