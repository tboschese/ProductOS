{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-os.dev/schemas/eval-config.schema.json",
  "title": "ProductOS Codex evaluation pilot configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "suite", "system_under_test", "instruction_paths", "generator", "judge", "repetitions", "timeout_seconds"],
  "properties": {
    "id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
    "schema_version": {"const": "0.3.0"},
    "suite": {"type": "string", "minLength": 1},
    "system_under_test": {"$ref": "https://product-os.dev/schemas/eval-run.schema.json#/properties/system_under_test"},
    "instruction_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "generator": {"$ref": "#/$defs/executor"},
    "judge": {
      "allOf": [
        {"$ref": "https://product-os.dev/schemas/eval-run.schema.json#/$defs/judge"},
        {"$ref": "#/$defs/modelSettings"},
        {"properties": {"calibration_status": {"const": "pilot"}}}
      ]
    },
    "repetitions": {"type": "integer", "minimum": 1},
    "timeout_seconds": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "executor": {
      "allOf": [
        {"$ref": "https://product-os.dev/schemas/eval-run.schema.json#/$defs/executor"},
        {"$ref": "#/$defs/modelSettings"}
      ]
    },
    "modelSettings": {
      "properties": {
        "type": {"const": "model"},
        "provider": {"const": "openai"},
        "model": {"type": "string", "minLength": 1},
        "prompt_version": {"const": "pilot-v1"},
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reasoning_effort", "service_tier"],
          "properties": {
            "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh", "max", "ultra"]},
            "service_tier": {"enum": ["priority", "default"]}
          }
        }
      }
    }
  }
}
