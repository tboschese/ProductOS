{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-os.dev/schemas/decision-record.schema.json",
  "title": "ProductOS decision record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "schema_version", "title", "locale", "created_at", "request", "context",
    "decision", "framing", "evidence", "uncertainties", "hypotheses", "risks", "options",
    "recommendation", "execution", "measurement", "learning"
  ],
  "properties": {
    "id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
    "schema_version": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/schemaVersion"},
    "title": {"type": "string", "minLength": 1},
    "locale": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/locale"},
    "created_at": {"type": "string", "format": "date"},
    "request": {"type": "string", "minLength": 1},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["known", "assumed", "unknown"],
      "properties": {
        "known": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "assumed": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "unknown": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "type", "owner", "deadline", "time_horizon", "reversibility", "scope", "constraints"],
      "properties": {
        "question": {"type": "string", "minLength": 1},
        "type": {"type": "string", "enum": ["diagnosis", "choice", "investment", "commitment", "policy", "stop_continue"]},
        "owner": {"type": ["string", "null"]},
        "deadline": {"type": ["string", "null"], "format": "date"},
        "time_horizon": {"type": "string", "minLength": 1},
        "reversibility": {"type": "string", "enum": ["reversible", "partially_reversible", "hard_to_reverse"]},
        "scope": {"type": "string", "minLength": 1},
        "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "framing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stated_problem", "reframed_problem", "classification"],
      "properties": {
        "stated_problem": {"type": "string", "minLength": 1},
        "reframed_problem": {"type": "string", "minLength": 1},
        "classification": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "enum": ["symptom", "cause", "assumption", "request", "opportunity", "constraint"]},
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "https://product-os.dev/schemas/evidence-item.schema.json"}
    },
    "uncertainties": {
      "type": "array",
      "items": {"$ref": "https://product-os.dev/schemas/uncertainty.schema.json"}
    },
    "hypotheses": {
      "type": "array",
      "items": {"$ref": "https://product-os.dev/schemas/hypothesis.schema.json"}
    },
    "risks": {
      "type": "array",
      "items": {"$ref": "https://product-os.dev/schemas/risk.schema.json"}
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "evidence_for_ids", "evidence_against_ids", "trade_offs"],
        "properties": {
          "id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "evidence_for_ids": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/idList"},
          "evidence_against_ids": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/idList"},
          "trade_offs": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "rationale", "evidence_ids", "unknowns", "confidence", "conditions", "dissent", "defer"],
      "properties": {
        "decision": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_ids": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/idList"},
        "unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "confidence": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/confidence"},
        "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "dissent": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "defer": {"type": "boolean"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "dependencies", "owners"],
      "properties": {
        "actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "owners": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "success_metrics", "leading_indicators", "guardrails", "counter_metrics", "window", "instrumentation_checks"],
      "properties": {
        "baseline": {"type": "string", "minLength": 1},
        "success_metrics": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "leading_indicators": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "guardrails": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "counter_metrics": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "window": {"type": "string", "minLength": 1},
        "instrumentation_checks": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "review_at", "questions"],
      "properties": {
        "status": {"type": "string", "enum": ["not_started", "in_progress", "reviewed"]},
        "review_at": {"type": ["string", "null"], "format": "date"},
        "questions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
