{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-os.dev/schemas/hypothesis.schema.json",
  "title": "ProductOS decision hypothesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "claim", "supporting_evidence_ids", "contradicting_evidence_ids", "confidence",
    "impact_if_true", "test_method", "decision_change_evidence", "status"
  ],
  "properties": {
    "id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
    "claim": {"type": "string", "minLength": 1},
    "supporting_evidence_ids": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/idList"},
    "contradicting_evidence_ids": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/idList"},
    "confidence": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/confidence"},
    "impact_if_true": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "test_method": {"type": "string", "minLength": 1},
    "decision_change_evidence": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["untested", "active", "supported", "weakened", "rejected"]}
  }
}
