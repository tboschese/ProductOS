{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-os.dev/schemas/eval-packet.schema.json",
  "title": "ProductOS evaluation export packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite_id", "schema_version", "audience", "scoring_status", "cases"],
  "properties": {
    "suite_id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
    "schema_version": {"const": "0.3.0"},
    "audience": {"enum": ["generator", "reviewer"]},
    "scoring_status": {"const": "unscored"},
    "cases": {"type": "array", "minItems": 1},
    "suite": {"$ref": "https://product-os.dev/schemas/eval-suite.schema.json"}
  },
  "if": {"properties": {"audience": {"const": "generator"}}},
  "then": {
    "properties": {
      "suite": false,
      "cases": {"items": {"$ref": "#/$defs/generatorCase"}}
    }
  },
  "else": {
    "required": ["suite"],
    "properties": {
      "cases": {"items": {"$ref": "https://product-os.dev/schemas/eval-case.schema.json"}}
    }
  },
  "$defs": {
    "generatorCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "locale", "input", "context"],
      "properties": {
        "id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
        "locale": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/locale"},
        "input": {"type": "string", "minLength": 1},
        "context": {"type": "object"}
      }
    }
  }
}
