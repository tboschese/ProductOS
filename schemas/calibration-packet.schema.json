{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-os.dev/schemas/calibration-packet.schema.json",
  "title": "ProductOS blind judge-calibration packet",
  "description": "Given to independent reviewers. Must not contain automated scores, response provenance, or control labels.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audience", "rubric", "rubric_sha256", "items"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "audience": {"const": "calibration_reviewer"},
    "rubric": {"type": "string", "minLength": 1},
    "rubric_sha256": {"$ref": "#/$defs/sha256"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "case", "response"],
        "properties": {
          "item_id": {"$ref": "#/$defs/itemId"},
          "case": {"$ref": "#/$defs/reviewCase"},
          "response": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "itemId": {"type": "string", "pattern": "^item-[0-9]{3}$"},
    "reviewCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "locale", "title", "input", "context", "applicable_dimensions",
        "expected_behaviors", "forbidden_behaviors", "hard_failures", "scoring_notes",
        "citations_expected"
      ],
      "properties": {
        "id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
        "locale": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/locale"},
        "title": {"type": "string", "minLength": 1},
        "input": {"type": "string", "minLength": 1},
        "context": {"type": "object"},
        "applicable_dimensions": {"$ref": "https://product-os.dev/schemas/eval-case.schema.json#/properties/applicable_dimensions"},
        "expected_behaviors": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
        "forbidden_behaviors": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
        "hard_failures": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
        "scoring_notes": {"type": "string"},
        "citations_expected": {"type": "boolean"}
      }
    }
  }
}
