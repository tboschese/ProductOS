{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-os.dev/schemas/case.schema.json",
  "title": "ProductOS product case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "schema_version", "name", "primary_domain", "facets", "context", "customer_problem",
    "business_model", "strategic_choices", "product_choices", "trade_offs", "outcomes", "failures",
    "limitations", "lessons", "source_refs", "status", "review"
  ],
  "properties": {
    "id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
    "schema_version": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/schemaVersion"},
    "name": {"type": "string", "minLength": 1},
    "primary_domain": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
    "facets": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/facets"},
    "context": {"type": "string", "minLength": 1},
    "customer_problem": {"type": "string", "minLength": 1},
    "business_model": {"type": "string", "minLength": 1},
    "strategic_choices": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
    "product_choices": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
    "trade_offs": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
    "outcomes": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
    "failures": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "limitations": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
    "lessons": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/sourceReference"}
    },
    "status": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/status"},
    "review": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/review"}
  }
}
