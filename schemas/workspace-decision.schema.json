{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-os.dev/schemas/workspace-decision.schema.json",
  "title": "Local user decision workspace, not approved canonical knowledge",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "revision", "title", "locale", "question", "context", "evidence", "created_at", "updated_at", "chosen_decision", "next_action"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "id": {"type": "string", "pattern": "^decision-[a-f0-9]{32}$"},
    "revision": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "locale": {"enum": ["pt-BR", "en", "es"]},
    "question": {"type": "string", "minLength": 1, "maxLength": 10000},
    "context": {"type": "string", "maxLength": 100000},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "chosen_decision": {"type": "string", "maxLength": 50000},
    "next_action": {"type": "string", "maxLength": 10000},
    "evidence": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "statement", "epistemic_status", "source", "locator", "limitations", "content"],
        "properties": {
          "id": {"type": "string", "pattern": "^evidence-[a-f0-9]{32}$"},
          "statement": {"type": "string", "minLength": 1, "maxLength": 10000},
          "epistemic_status": {"enum": ["fact", "observation", "interpretation", "assumption", "hypothesis", "opinion", "unknown"]},
          "source": {"type": "string", "minLength": 1, "maxLength": 2000},
          "locator": {"type": "string", "minLength": 1, "maxLength": 2000},
          "limitations": {"type": "string", "maxLength": 10000},
          "content": {"type": "string", "maxLength": 200000}
        }
      }
    }
  }
}
