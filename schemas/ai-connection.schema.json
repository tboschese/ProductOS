{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-os.dev/schemas/ai-connection.schema.json",
  "title": "User-selected local AI connection, without credential contents",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "model", "command", "timeout_seconds"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "kind": {"enum": ["manual", "codex", "command"]},
    "model": {"type": ["string", "null"], "minLength": 1, "maxLength": 300},
    "command": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1}},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "command"}}}, "then": {"properties": {"command": {"minItems": 1}}}},
    {"if": {"properties": {"kind": {"const": "manual"}}}, "then": {"properties": {"command": {"maxItems": 0}}}},
    {"if": {"properties": {"kind": {"const": "codex"}}}, "then": {"properties": {"command": {"maxItems": 1}}}}
  ]
}
