{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-os.dev/schemas/eval-suite.schema.json",
  "title": "ProductOS evaluation suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "title", "purpose", "case_ids", "status", "review"],
  "properties": {
    "id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
    "schema_version": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/schemaVersion"},
    "title": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"}
    },
    "status": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/status"},
    "review": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/review"}
  }
}
