{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-os.dev/schemas/eval-suite.schema.json",
  "title": "ProductOS evaluation suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "schema_version", "title", "purpose", "case_ids", "gate_policy", "status", "review"
  ],
  "properties": {
    "id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
    "schema_version": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/schemaVersion"},
    "title": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"}
    },
    "gate_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_hard_failures", "minimum_expected_behavior_coverage",
        "maximum_forbidden_behavior_violations", "critical_dimensions",
        "minimum_critical_average", "minimum_critical_score",
        "minimum_citation_coverage", "maximum_multilingual_delta"
      ],
      "properties": {
        "maximum_hard_failures": {"type": "integer", "minimum": 0},
        "minimum_expected_behavior_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximum_forbidden_behavior_violations": {"type": "integer", "minimum": 0},
        "critical_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/rubricDimension"}
        },
        "minimum_critical_average": {"type": "number", "minimum": 0, "maximum": 4},
        "minimum_critical_score": {"type": "integer", "minimum": 0, "maximum": 4},
        "minimum_citation_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_multilingual_delta": {"type": "number", "minimum": 0, "maximum": 4}
      }
    },
    "status": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/status"},
    "review": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/review"}
  }
}
