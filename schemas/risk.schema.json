{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-os.dev/schemas/risk.schema.json",
  "title": "ProductOS decision risk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "category", "statement", "cause", "consequence", "likelihood", "impact",
    "stakeholders", "reversibility", "time_to_detect", "prevention", "mitigation",
    "contingency", "owner", "indicators", "residual_risk"
  ],
  "properties": {
    "id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
    "category": {
      "type": "string",
      "enum": ["value", "usability", "feasibility", "business_viability", "market", "operational", "regulatory", "security", "privacy", "safety", "reputation", "execution", "organizational"]
    },
    "statement": {"type": "string", "minLength": 1},
    "cause": {"type": "string", "minLength": 1},
    "consequence": {"type": "string", "minLength": 1},
    "likelihood": {"type": "string", "enum": ["unknown", "low", "medium", "high"]},
    "impact": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "stakeholders": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reversibility": {"type": "string", "enum": ["reversible", "partially_reversible", "hard_to_reverse"]},
    "time_to_detect": {"type": "string", "minLength": 1},
    "prevention": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "mitigation": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "contingency": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "owner": {"type": ["string", "null"]},
    "indicators": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "residual_risk": {"type": "string", "minLength": 1}
  }
}
