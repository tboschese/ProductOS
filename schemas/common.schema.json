{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-os.dev/schemas/common.schema.json",
  "title": "ProductOS common definitions",
  "$defs": {
    "canonicalId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "in_review", "approved", "deprecated"]
    },
    "confidence": {
      "type": "string",
      "enum": ["very_low", "low", "medium", "high", "very_high"]
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "idList": {
      "type": "array",
      "items": {"$ref": "#/$defs/canonicalId"},
      "uniqueItems": true,
      "default": []
    },
    "nonEmptyStringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator", "role"],
      "properties": {
        "source_id": {"$ref": "#/$defs/canonicalId"},
        "locator": {"type": "string", "minLength": 1},
        "role": {
          "type": "string",
          "enum": ["supports", "contradicts", "background"]
        },
        "notes": {"type": "string"}
      }
    },
    "facets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilities": {"$ref": "#/$defs/idList"},
        "practices": {"$ref": "#/$defs/idList"},
        "contexts": {"$ref": "#/$defs/idList"},
        "product_types": {"$ref": "#/$defs/idList"},
        "roles_interfaces": {"$ref": "#/$defs/idList"},
        "constraints": {"$ref": "#/$defs/idList"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "created_at", "updated_at"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "reviewers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "default": []
        },
        "created_at": {"type": "string", "format": "date"},
        "updated_at": {"type": "string", "format": "date"},
        "next_review_at": {"type": ["string", "null"], "format": "date"}
      }
    }
  }
}
