{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-os.dev/schemas/decision-pattern.schema.json",
  "title": "ProductOS decision pattern",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "schema_version", "name", "decision_question", "primary_domain", "facets",
    "signals", "competing_hypotheses", "evidence_needed", "trade_offs", "measurement",
    "anti_pattern_ids", "claim_ids", "status", "review"
  ],
  "properties": {
    "id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
    "schema_version": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/schemaVersion"},
    "name": {"type": "string", "minLength": 1},
    "decision_question": {"type": "string", "minLength": 1},
    "primary_domain": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
    "facets": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/facets"},
    "signals": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
    "competing_hypotheses": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
    "evidence_needed": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
    "trade_offs": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
    "measurement": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
    "anti_pattern_ids": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/idList"},
    "claim_ids": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/idList"},
    "status": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/status"},
    "review": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/review"}
  }
}
