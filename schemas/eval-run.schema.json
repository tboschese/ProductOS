{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-os.dev/schemas/eval-run.schema.json",
  "title": "ProductOS behavioral evaluation run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "schema_version", "suite_id", "run_status", "started_at", "completed_at",
    "repository_revision", "system_under_test", "generator", "judge", "repetitions",
    "assessments"
  ],
  "properties": {
    "id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
    "schema_version": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/schemaVersion"},
    "suite_id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
    "run_status": {"type": "string", "enum": ["partial", "completed"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "repository_revision": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision_role", "worktree_dirty", "cli_version", "files"],
      "properties": {
        "revision_role": {"const": "base_commit"},
        "worktree_dirty": {"type": "boolean"},
        "cli_version": {"type": "string", "minLength": 1},
        "files": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "system_under_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "instruction_path"],
      "properties": {
        "id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
        "version": {"type": "string", "minLength": 1},
        "instruction_path": {"type": "string", "minLength": 1}
      }
    },
    "generator": {"$ref": "#/$defs/executor"},
    "judge": {"$ref": "#/$defs/judge"},
    "repetitions": {"type": "integer", "minimum": 1},
    "assessments": {
      "type": "array",
      "minItems": 0,
      "items": {"$ref": "#/$defs/assessment"}
    }
  },
  "if": {"properties": {"run_status": {"const": "completed"}}},
  "then": {"properties": {"assessments": {"minItems": 1}}},
  "$defs": {
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "identities", "provider", "model", "prompt_version", "settings"],
      "properties": {
        "type": {"type": "string", "enum": ["human", "model", "hybrid"]},
        "identities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "provider": {"type": ["string", "null"], "minLength": 1},
        "model": {"type": ["string", "null"], "minLength": 1},
        "prompt_version": {"type": ["string", "null"], "minLength": 1},
        "settings": {"type": "object"}
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type", "identities", "provider", "model", "prompt_version", "settings",
        "rubric_version", "calibration_status"
      ],
      "properties": {
        "type": {"type": "string", "enum": ["human", "model", "hybrid"]},
        "identities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "provider": {"type": ["string", "null"], "minLength": 1},
        "model": {"type": ["string", "null"], "minLength": 1},
        "prompt_version": {"type": ["string", "null"], "minLength": 1},
        "settings": {"type": "object"},
        "rubric_version": {"type": "string", "minLength": 1},
        "calibration_status": {
          "type": "string",
          "enum": ["uncalibrated", "pilot", "calibrated"]
        }
      }
    },
    "behaviorCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["behavior", "observed", "evidence"],
      "properties": {
        "behavior": {"type": "string", "minLength": 1},
        "observed": {"type": "boolean"},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "citationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "material_claims", "supported_claims", "notes"],
      "properties": {
        "expected": {"type": "boolean"},
        "material_claims": {"type": "integer", "minimum": 0},
        "supported_claims": {"type": "integer", "minimum": 0},
        "notes": {"type": "string"}
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id", "repetition", "response", "dimension_scores",
        "expected_behavior_checks", "forbidden_behavior_checks", "hard_failure_checks",
        "citation_check", "notes"
      ],
      "properties": {
        "case_id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
        "repetition": {"type": "integer", "minimum": 1},
        "response": {"type": "string", "minLength": 1},
        "dimension_scores": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/rubricDimension"
          },
          "additionalProperties": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 4
          }
        },
        "expected_behavior_checks": {
          "type": "array",
          "items": {"$ref": "#/$defs/behaviorCheck"}
        },
        "forbidden_behavior_checks": {
          "type": "array",
          "items": {"$ref": "#/$defs/behaviorCheck"}
        },
        "hard_failure_checks": {
          "type": "array",
          "items": {"$ref": "#/$defs/behaviorCheck"}
        },
        "citation_check": {"$ref": "#/$defs/citationCheck"},
        "notes": {"type": "string"}
      }
    }
  }
}
