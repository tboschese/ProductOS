{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-os.dev/schemas/eval-case.schema.json",
  "title": "ProductOS evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "schema_version", "case_family_id", "title", "locale", "input", "context",
    "applicable_dimensions", "expected_behaviors", "forbidden_behaviors", "hard_failures",
    "scoring_notes", "tags", "status", "review"
  ],
  "properties": {
    "id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
    "schema_version": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/schemaVersion"},
    "case_family_id": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/canonicalId"},
    "title": {"type": "string", "minLength": 1},
    "locale": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/locale"},
    "input": {"type": "string", "minLength": 1},
    "context": {"type": "object"},
    "applicable_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/rubricDimension"}
    },
    "citations_expected": {"type": "boolean", "default": false},
    "expected_behaviors": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
    "forbidden_behaviors": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
    "hard_failures": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/nonEmptyStringList"},
    "scoring_notes": {"type": "string"},
    "tags": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/idList"},
    "status": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/status"},
    "review": {"$ref": "https://product-os.dev/schemas/common.schema.json#/$defs/review"}
  }
}
