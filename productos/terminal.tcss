Screen {
    background: #0c1918;
    color: #def1e8;
}
Header { background: #142824; color: #74d7be; }
Footer { background: #142824; }
#shell { height: 1fr; }
#sidebar {
    width: 28;
    padding: 1 2;
    background: #142824;
    border-right: solid #315248;
}
#main { width: 1fr; padding: 1 2; }
.eyebrow { color: #a2bfb0; margin-bottom: 1; }
#decisions { height: 1fr; margin: 1 0; background: #142824; }
ListItem { padding: 1; }
ListItem:hover { background: #243e36; }
#decision-heading { height: auto; text-style: bold; color: #74d7be; margin-bottom: 1; }
.hint { color: #a2bfb0; height: auto; margin: 1 0; }
#status { height: auto; min-height: 2; margin-top: 1; color: #a2bfb0; }
TabbedContent { height: 1fr; }
ContentSwitcher { height: 1fr; min-height: 0; }
TabPane { height: 1fr; min-height: 0; padding: 1 0; overflow-y: auto; }
Input { background: #142824; border: tall #315248; margin-bottom: 1; }
Input:focus { border: tall #74d7be; }
TextArea { background: #142824; border: solid #315248; }
TextArea:focus { border: solid #74d7be; }
#context, #chosen-decision { height: 1fr; margin-bottom: 1; min-height: 5; }
#chosen-decision { min-height: 3; }
Label { height: auto; margin-bottom: 1; }
Button { margin-right: 1; border: tall #315248; background: #142824; color: #def1e8; }
Button.-primary { background: #276b57; color: #def1e8; border: tall #276b57; }
Button:focus { border: tall #74d7be; }
.actions { height: auto; min-height: 3; margin: 1 0; }
.actions Input { width: 1fr; }
#analysis-actions { layout: grid; grid-size: 2; grid-columns: 1fr 1fr; height: 6; }
#analysis-actions Button { width: 1fr; min-width: 10; }
#evidence-table { height: 1fr; min-height: 5; background: #142824; }
#evidence-detail { height: auto; max-height: 10; overflow-y: auto; margin: 1 0; }
#analysis-status { height: auto; margin: 1 0; color: #a2bfb0; }
#answer-scroll { height: 1fr; background: #142824; padding: 1 2; }
Markdown { background: #142824; }
Select { margin-bottom: 1; }
FormScreen { align: center middle; background: #071210 80%; }
.dialog {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 95%;
    padding: 1 2;
    background: #142824;
    border: solid #74d7be;
}
.dialog-title { text-style: bold; color: #74d7be; margin-bottom: 1; }
.form-error { height: auto; color: #ffb4a5; }
.connection-dialog, .evidence-dialog, .import-dialog { height: 90%; }
#codex-settings, #command-settings { height: auto; }
#connection-command { height: 5; }
#evidence-limitations { height: 4; margin-bottom: 1; }
#evidence-content { height: 7; }
#import-answer { height: 1fr; min-height: 10; margin-bottom: 1; }
.export-dialog { height: 90%; }
#export-prompt { height: 1fr; }
